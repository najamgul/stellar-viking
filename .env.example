# ─── Google Gemini ────────────────────────────────────────
# Get a key: https://aistudio.google.com/apikey
# Powers: WhatsApp chat engine, knowledge base embeddings, call summaries, Gemini voice
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-live-001

# ─── Embeddings (Google or OpenAI) ───────────────────────
EMBEDDING_MODEL=text-embedding-004

# ─── Twilio (voice calls) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx

# ─── WhatsApp (Meta Cloud API) ───────────────────────────
# Full setup walkthrough: docs/WHATSAPP_SETUP.md
# Permanent System User token (NOT the 24h temporary token from API Setup)
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
# Any string you invent — enter the SAME value in Meta's webhook config form
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
# Meta app secret (App Settings → Basic → App secret) — webhook signature checks
WHATSAPP_APP_SECRET=your-app-secret
# Approved template used to re-engage leads after the 24h window closes.
# Body must have two variables: {{1}} = lead name, {{2}} = topic.
WHATSAPP_FOLLOWUP_TEMPLATE=followup_checkin
# Must match the template's language code EXACTLY as created in Meta (en vs en_US!)
WHATSAPP_TEMPLATE_LANGUAGE=en
# Chat LLM (uses GEMINI_API_KEY)
CHAT_MODEL=gemini-2.0-flash

# ─── Admin auth (REQUIRED in production — server refuses to start without) ─
ADMIN_USER=admin
ADMIN_PASS=change-me
ADMIN_SECRET=random-long-secret-for-tokens

# ─── Pinecone (Vector DB) ───────────────────────────────
PINECONE_API_KEY=xxxx
PINECONE_INDEX_NAME=stellar-viking

# ─── Google Cloud (Firestore + Storage) ─────────────────
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCS_BUCKET_NAME=stellar-viking-recordings

# ─── Server ─────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Public URL ─────────────────────────────────────────
# Dev: your ngrok URL. Production: https://your-domain.com
PUBLIC_URL=https://your-ngrok-url.ngrok.io

# ─── Encryption Key (for tool credentials at rest) ──────
ENCRYPTION_KEY=your-32-char-encryption-key-here
