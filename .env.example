# â”€â”€â”€ Google Gemini â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get a key: https://aistudio.google.com/apikey
# Powers: WhatsApp chat engine, knowledge base embeddings, call summaries, Gemini voice
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-live-001

# â”€â”€â”€ Embeddings (Google or OpenAI) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
EMBEDDING_MODEL=gemini-embedding-001

# â”€â”€â”€ Twilio (voice calls) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx

# â”€â”€â”€ WhatsApp (Meta Cloud API) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Full setup walkthrough: docs/WHATSAPP_SETUP.md
# Permanent System User token (NOT the 24h temporary token from API Setup)
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
# Any string you invent â€” enter the SAME value in Meta's webhook config form
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
# Meta app secret (App Settings â†’ Basic â†’ App secret) â€” webhook signature checks
WHATSAPP_APP_SECRET=your-app-secret
# Approved template used to re-engage leads after the 24h window closes.
# Body must have two variables: {{1}} = lead name, {{2}} = topic.
WHATSAPP_FOLLOWUP_TEMPLATE=followup_checkin
# Must match the template's language code EXACTLY as created in Meta (en vs en_US!)
WHATSAPP_TEMPLATE_LANGUAGE=en
# Chat LLM (uses GEMINI_API_KEY)
CHAT_MODEL=gemini-flash-latest

# â”€â”€â”€ Chat provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# 'gemini' (default â€” native tools + voice-note transcription) or
# 'replicate' (DeepSeek-V3.1 etc; text only, tools via in-prompt protocol,
# voice notes still transcribed by Gemini). Per-agent override: agent.chatProvider.
CHAT_PROVIDER=gemini
# Only needed when CHAT_PROVIDER=replicate:
REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=google/gemini-2.5-flash
REPLICATE_MAX_TOKENS=1500
REPLICATE_TEMPERATURE=0.7

# â”€â”€â”€ CRM sync connector (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Pushes leads, chat transcripts and BD alerts to an external CRM that
# implements the connector contract (see src/integrations/crm-sync.js).
# Per-agent overrides: agent.crmSyncUrl / agent.crmSyncKey.
# Unset = feature off.
CRM_SYNC_URL=https://your-crm.example.com/api/ingest/chatbot
CRM_SYNC_KEY=shared-secret-sent-as-x-crm-key

# â”€â”€â”€ Paid re-engagement drip (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# After the free 24h window closes, silent leads get PAID template messages
# at these hours-since-their-last-message. List length = per-lead spend cap.
# After the last attempt + 48h of silence, the lead is auto-marked
# unresponsive in the CRM and never messaged again. Set REENGAGE_ENABLED=false to turn off.
REENGAGE_DELAYS_HOURS=26,72,168
REENGAGE_ENABLED=true

# Automated outreach window (lead-local hours) â€” nudges, window-savers,
# drips and scheduled follow-ups only fire inside this window. Direct
# replies to incoming messages are always immediate.
OUTREACH_START_HOUR=10
OUTREACH_END_HOUR=19

# â”€â”€â”€ Admin auth (REQUIRED in production â€” server refuses to start without) â”€
ADMIN_USER=admin
ADMIN_PASS=change-me
ADMIN_SECRET=random-long-secret-for-tokens

# â”€â”€â”€ Pinecone (Vector DB) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PINECONE_API_KEY=xxxx
PINECONE_INDEX_NAME=stellar-viking

# â”€â”€â”€ Google Cloud (Firestore + Storage) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCS_BUCKET_NAME=stellar-viking-recordings

# â”€â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# â”€â”€â”€ Public URL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Dev: your ngrok URL. Production: https://your-domain.com
PUBLIC_URL=https://your-ngrok-url.ngrok.io

# â”€â”€â”€ Encryption Key (for tool credentials at rest) â”€â”€â”€â”€â”€â”€
ENCRYPTION_KEY=your-32-char-encryption-key-here
